+/* Production readiness is bound to this exact executable and checkpoint.
+ * Qualification runs stay available through the explicit experimental flag. */
+static int dsv4_require_qualification(const char *snapshot,int context,int chunk) {
+    const char *cuda=getenv("COLI_CUDA"),*dspark=getenv("DSPARK");
+    if (context!=40960 || !cuda || strcmp(cuda,"1") ||
+        (dspark && strcmp(dspark,"off")) || dsv4_budget_gb("RAM_GB",8)!=8 ||
+        dsv4_budget_gb("CUDA_EXPERT_GB",2)!=2 || dsv4_budget_gb("CUDA_HEADROOM_GB",1.5)!=1.5) {
+        fprintf(stderr,"deepseek_v4: production requires the qualified 40960-context CUDA profile, 8/2 GiB caches, 1.5 GiB headroom and DSpark off\n");
+        return 0;
+    }
+    char executable[4096],helper[4096],chunk_text[16];
+    ssize_t length=readlink("/proc/self/exe",executable,sizeof(executable)-1);
+    if (length<1 || length>=(ssize_t)sizeof(executable)-1) return 0;
+    executable[length]=0;char *slash=strrchr(executable,'/');if (!slash) return 0;
+    if (snprintf(helper,sizeof(helper),"%.*s/tools/deepseek_v4_qualification.py",(int)(slash-executable),executable)>=(int)sizeof(helper)) return 0;
+    snprintf(chunk_text,sizeof(chunk_text),"%d",chunk);
+    pid_t child=fork();if (child<0) return 0;
+    if (!child) {
+        execlp("python3","python3","-I",helper,"--snapshot",snapshot,"--engine",executable,"--chunk",chunk_text,(char*)NULL);
+        _exit(78);
+    }
+    int status;pid_t result;
+    do {result=waitpid(child,&status,0);} while (result<0 && errno==EINTR);
+    return result==child && WIFEXITED(status) && WEXITSTATUS(status)==0;
+}
