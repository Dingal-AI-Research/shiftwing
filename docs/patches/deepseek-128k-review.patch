+import assert from "node:assert/strict";
+import { it } from "node:test";
+import { DEEPSEEK_REVIEW } from "../../inference/deepseek-review.ts";
+import { executeOrchestratorToolCall, hashStructuredValue } from "../../orchestrator/tools.ts";
+import { createAuditGateState, createScaffoldAuditWorkSpec } from "../audit-agent.ts";
+import type { ToolExecutionContext, MediatedHarnessResult } from "../types.ts";
+
+const scaffold = { goal: "Preserve inventory contract", task_type: "editing", evidence_needed: [],
+  intended_files: ["src/inventory.ts"], suspected_files: [], suspected_functions: [], steps: ["Implement inventory"],
+  risks: [], acceptance_checks: ["Preserve the API"], verification: ["Focused tests"] };
+const result = (text: string): MediatedHarnessResult => ({ text, toolCalls: [], iterations: 1, usage: null, messages: [] });
+const approval = JSON.stringify({ verdict: "approved", required_actions: [], non_blocking_notes: [],
+  focused_test_evidence_reviewed: "pending", recommendation: "Test now" });
+
+for (const kind of ["code_review", "strategy_scaffold"] as const) {
+  for (const actualTokens of [131072, 131073]) {
+    it(`${kind} ${actualTokens === 131072 ? "accepts 128k" : "rejects mandatory context above 128k"} before dispatch`, async () => {
+      let counted = 0, dispatched = 0;
+      const ctx: ToolExecutionContext = {
+        cwd: process.cwd(), workspaceId: "deepseek-budget-test", allowedPaths: ["*"],
+        readFiles: async () => ({}), writeFiles: async () => {},
+        gitDiff: async () => "diff --git a/src/inventory.ts b/src/inventory.ts\n--- a/src/inventory.ts\n+++ b/src/inventory.ts\n@@ -1 +1 @@\n-old\n+new",
+        gitStatus: async () => " M src/inventory.ts",
+        runNamedCommand: async () => ({ stdout: "", stderr: "", exitCode: 0 }),
+        auditRootRequest: "Preserve the original inventory API contract",
+        auditInputTokenLimit: DEEPSEEK_REVIEW.inputTokens, auditContextTokens: DEEPSEEK_REVIEW.contextTokens,
+        auditMaxOutputTokens: DEEPSEEK_REVIEW.outputTokens, auditGateEnforced: true, scaffoldAmendmentsEnabled: true,
+        taskComplexity: "complex", auditAgentModel: "deepseek-v4-flash-0731-colib",
+        swePhase: kind === "code_review" ? "review" : "localize", codeReviewRequired: kind === "code_review",
+        runReviewPreparation: async messages => {
+          assert.match(String(messages[0].content), /131072 actual rendered tokens/);
+          return JSON.stringify({ summary: "Check the API boundary.", excerpts: [] });
+        },
+        // Mock the native counter receipt to exercise exact boundary decisions,
+        // independently of the character estimator and without loading a model.
+        countReviewTokens: async (_messages, outputTokens) => {
+          counted++;
+          assert.equal(outputTokens, 8192);
+          return actualTokens;
+        },
+        runAuditAgent: async (messages, _model, _event, _id, options) => {
+          dispatched++;
+          assert.equal(options?.maxOutputTokens, 8192);
+          assert.match(JSON.stringify(messages), /original inventory API contract/);
+          return result(kind === "code_review" ? approval : JSON.stringify({ amended_scaffold: scaffold, notes: [], unresolved_issues: [] }));
+        },
+      };
+      if (kind === "code_review") {
+        ctx.strategyScaffold = structuredClone(scaffold);
+        ctx.strategyScaffoldHash = hashStructuredValue(scaffold);
+        ctx.auditGate = createAuditGateState({ workSpec: createScaffoldAuditWorkSpec(scaffold), rawText: JSON.stringify({
+          verdict: "approved", summary: "Ready", required_changes: [], risks: [], acceptance_gaps: [], recommendation: "Proceed",
+        }) });
+      }
+      const response = await executeOrchestratorToolCall({ id: "budget-" + kind, name: kind,
+        args: kind === "code_review" ? { tasks: ["Check the complete change"] } : structuredClone(scaffold) }, ctx);
+      assert.ok(counted > 0, response.output);
+      const gate = kind === "code_review" ? ctx.codeReviewGate : ctx.auditGate;
+      if (actualTokens === 131072) {
+        assert.notEqual(response.isError, true, response.output);
+        assert.equal(dispatched, 1);
+        assert.equal(gate?.passed, true);
+      } else {
+        assert.equal(response.isError, true, response.output);
+        assert.equal(dispatched, 0);
+        assert.equal(gate?.passed, false);
+        assert.match(response.output, /budget/);
+      }
+    });
+  }
+}
